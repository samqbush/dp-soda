#!/bin/sh

# Ensure PATH includes common locations for npm/node
export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin:$HOME/.nvm/versions/node/*/bin"

# Add node_modules/.bin to PATH for project-local executables
export PATH="./node_modules/.bin:$PATH"

# Note: husky v9 invokes this file via `sh -e`, so any failing command below
# aborts the hook. Do not add `set -e` or `&&` chaining.

# Skip pre-commit for users with GitHub web interface emails (users.noreply.github.com)
# These users are committing from GitHub web and can't run local hooks
CURRENT_EMAIL=$(git config user.email)
if echo "$CURRENT_EMAIL" | grep -q "@users\.noreply\.github\.com"; then
  echo "Skipping pre-commit hooks for GitHub web user: $CURRENT_EMAIL"
  exit 0
fi

# Change classification.
#
# Two independent questions, deliberately not conflated:
#
#   NO_RELEASE  - can this change alter the shipped app? If not, no version bump
#                 is needed. The version check exists only because create-release
#                 tags from the app version, so demanding a bump for a change that
#                 can never produce a release is pure friction.
#   NO_LINT     - is there anything here a linter can even read? Markdown, JSON data
#                 and CSV are not lintable by this toolchain.
#
# The rules live in scripts/classify-changes.mjs, shared with the `classify` job in
# .github/workflows/build-and-release.yml. Keeping one implementation is the point:
# this used to be a hand-maintained list here and a second copy as paths-ignore in
# the workflow, in two different glob dialects.
#
# --no-renames is required: with rename detection, --name-only reports only the
# destination path, so `app/foo.ts -> docs/foo.md` would look like a doc change.
# No --diff-filter is used: filtering to ACMR would drop deletions, so removing
# a source file alongside a README edit would look like a doc change.
STAGED_FILES=$(git diff --cached --name-only --no-renames)

# If node is unavailable for any reason, fall through to the full checks rather
# than silently waving a change through.
CLASSIFY=$(printf '%s\n' "$STAGED_FILES" | node scripts/classify-changes.mjs 2>/dev/null) || CLASSIFY=""

NO_RELEASE=$(printf '%s\n' "$CLASSIFY" | sed -n 's/^no_release=//p')
NO_LINT=$(printf '%s\n' "$CLASSIFY" | sed -n 's/^no_lint=//p')
HAS_STAGED=$(printf '%s\n' "$CLASSIFY" | sed -n 's/^has_files=//p')

# An empty index (for example a message-only `git commit --amend`) falls through
# to the full checks rather than being treated as a no-release change.
if [ "$HAS_STAGED" = "true" ] && [ "$NO_RELEASE" = "true" ] && [ "$NO_LINT" = "true" ]; then
  echo "📝 Docs/data-only change — skipping lint and version checks"
  exit 0
fi

npm run lint

if [ "$HAS_STAGED" = "true" ] && [ "$NO_RELEASE" = "true" ]; then
  echo "🔬 Research-only change — linted, skipping version check (cannot trigger a release)"
  exit 0
fi

npm run test-version
