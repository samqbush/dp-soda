# Environment Variables for Dawn Patrol App
# Copy this file to .env and fill in your actual API credentials

# Ecowitt API Configuration
# These are compiled into the shipped app. Ecowitt rate-limits per account, so keep bulk
# traffic OFF these keys — see ECOWITT_RESEARCH_* below.
ECOWITT_APPLICATION_KEY=your_application_key_here
ECOWITT_API_KEY=your_api_key_here

# Ecowitt research credentials — a SEPARATE account/token, used only by the katabatic archive
# scripts (scripts/archive-ecowitt.mjs, scripts/katabatic-refresh.mjs).
#
# Why this must be a different token: a single archive backfill is several hundred requests and
# has tripped Ecowitt's rate limit in practice. Those keys above ship inside the mobile app, so
# exhausting that account's quota would break wind data on every installed user's phone. The
# archiver refuses to run without these rather than risk it.
ECOWITT_RESEARCH_APPLICATION_KEY=your_research_application_key_here
ECOWITT_RESEARCH_API_KEY=your_research_api_key_here

# OpenWeather API Key (used for weather forecasts)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Instructions:
# 1. Copy this file to .env (remove .example)
# 2. Replace 'your_api_key_here' with your actual API keys
# 3. Never commit the .env file to version control
# 4. For Expo builds, add these to app.config.js under extra
